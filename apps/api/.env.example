# LONGYU API configuration. Copy to .env and fill in. Never commit real secrets.

NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://longyu:CHANGE_ME@postgres:5432/longyu

# 32+ random bytes: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
SIWE_DOMAIN=longyu.network

# LONGYU L2 (testnet chain 668801)
RPC_URL=http://sequencer-rpc:8545
PUBLIC_RPC_URL=https://rpc-testnet.longyu.network
CHAIN_ID=668801
DISTRIBUTOR_ADDRESS=
FAUCET_ADDRESS=
EXPLORER_URL=https://scan-testnet.longyu.network
CHAIN_NAME=LONGYU Testnet
# Gas on LONGYU is BNB bridged from BSC (tBNB on the testnet); rewards are paid in the tLONG token.
NATIVE_SYMBOL=tBNB
# BNB per faucet drip, in wei (0.0002)
FAUCET_DRIP_WEI=200000000000000

# Who signs for the publisher, relayer and faucet signer. On Railway it is the private signer service
# (apps/signer), which holds the keys; this API holds none. Raw keys are refused in production.
SIGNER_URL=http://signer.railway.internal:8080
SIGNER_TOKEN=
# The other option, in place of SIGNER_URL: keys in AWS KMS (ECC_SECG_P256K1).
# KMS_REGION=ap-southeast-1
# KMS_PUBLISHER_KEY_ID=
# KMS_RELAYER_KEY_ID=
# KMS_FAUCET_SIGNER_KEY_ID=

# BNB Smart Chain, for Binance Account Bound Token checks
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Business payments (optional): partner orders paid in real USDT or BNB through PaymentRouter on BSC.
# Leave PAYMENT_ROUTER_ADDRESS blank to turn payments off. The watcher needs an RPC that serves
# eth_getLogs (NodeReal, Ankr, QuickNode...); BNB's public dataseed endpoints refuse it.
PAYMENT_ROUTER_ADDRESS=
PAYMENT_START_BLOCK=
TREASURY_ADDRESS=
PAYMENT_RPC_URL=
PAYMENT_CHAIN_ID=56
PAYMENT_TOKENS=USDT:0x55d398326f99059fF775485246999027B3197955:18,BNB:native:18
PAYMENT_FINALITY=finalized
# Order and payment notices go to this Telegram chat (both or neither; otherwise they are logged).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Paid mining boosts on sale: id:bps:days:TOKEN:price, comma-separated (empty: none on sale).
BOOST_PLANS=c1-7:1000:7:BNB:0.0014,c1-30:1000:30:BNB:0.0054,c1-90:1000:90:BNB:0.0144,c2-7:2500:7:BNB:0.0028,c2-30:2500:30:BNB:0.0108,c2-90:2500:90:BNB:0.0288,c3-7:5000:7:BNB:0.0049,c3-30:5000:30:BNB:0.0189,c3-90:5000:90:BNB:0.0504,c4-7:7500:7:BNB:0.007,c4-30:7500:30:BNB:0.027,c4-90:7500:90:BNB:0.072,c5-7:10000:7:BNB:0.0091,c5-30:10000:30:BNB:0.0351,c5-90:10000:90:BNB:0.0936
# The web page where buyers pay an order with their own wallet.
PAY_PAGE_URL=https://testnet.longyu.network/pay.html

# Cloudflare Turnstile (human check before mining and for the faucet)
TURNSTILE_SECRET=

# Sign-in with X (the only way to sign in). In the X developer portal the app's type is "Web App,
# Automated App or Bot" (a confidential client), and X_REDIRECT_URI is listed there, character for
# character, as a callback URL. All three are required in production.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://api-testnet.longyu.network/v1/auth/x/callback
# The app link the callback returns to (the mobile app's own scheme).
APP_AUTH_REDIRECT=longyumine://auth

# Identity vendor webhook secret (HMAC-SHA256 over the raw body)
VERIFICATION_WEBHOOK_SECRET=

# Device integrity
ANDROID_PACKAGE=app.longyu.mine
# Android: SHA-256 of the APK's signing certificate (from `apksigner verify --print-certs` on the released APK). Enables hardware key
# attestation, which works for an APK installed outside Google Play.
ANDROID_SIGNING_CERT_SHA256=
# Only for a Google Play build: a service account allowed to decode Play Integrity tokens.
GOOGLE_SERVICE_ACCOUNT_JSON=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=app.longyu.mine

# name:sha256(key) pairs. Generate a key: openssl rand -hex 24; hash it: echo -n KEY | sha256sum
ADMIN_KEYS=
# Read-only key for uptime monitors (opens /v1/admin/health only): sha256 hex of the key.
MONITOR_KEY_SHA256=
# Publisher and relayer gas balances below this raise a warning (critical at a fifth of it).
ALERT_MIN_GAS_BALANCE=0.05
# The batcher's and the proposer's gas on the L1 (BSC), read by the health check: the L1's RPC and
# name:address pairs. Balances below L1_MIN_GAS_BALANCE raise a warning (critical at a fifth of it).
L1_RPC_URL=
L1_WATCH=
L1_MIN_GAS_BALANCE=0.01

BLOCKED_COUNTRIES=CN,KP,IR,CU,SY
# Risk rules: accounts on one network address in a day, failed device checks, and the spread of start times in seconds.
RISK_IP_CLUSTER_LIMIT=20
RISK_ATTESTATION_FAILURES=5
RISK_TIMING_STDDEV_SECONDS=30
# Wallet-sweep rule: accounts sending rewards to one address within the window. Bridges and exchanges go in the allowlist.
SWEEP_MIN_ACCOUNTS=5
SWEEP_WINDOW_DAYS=14
SWEEP_ALLOWLIST=
# Requests must come through Cloudflare. List Cloudflare's published IP ranges here
# (https://www.cloudflare.com/ips/), never "true". Requests without a country header are refused.
TRUST_PROXY=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
REQUIRE_COUNTRY=true
# Hosts whose origin is reachable from the internet (Railway): Cloudflare adds this secret as the
# x-longyu-origin header (Transform Rule); requests without it are refused. 32+ random characters.
ORIGIN_SECRET=
# Origins of the web pages that may call this API: the claim page and LONGYU MINE in a browser
WEB_ORIGINS=https://testnet.longyu.network,https://mine-testnet.longyu.network
# Mining in a browser, for people without the Android app. A browser passes the human check at
# every session instead of the device check. "false" stops browser sign-ins and sessions at once.
WEB_MINING=true
# Where a browser returns after X: the web app's address, also listed in WEB_ORIGINS. Required with WEB_MINING.
WEB_AUTH_REDIRECT=https://mine-testnet.longyu.network/
# The invite bonus: each invited account that mines on a day raises its inviter's weight that day.
# "false" ends it from the next settlement on.
INVITE_REWARD=true
# Optional; defaults to a value derived from JWT_SECRET
PULSE_SECRET=
# Daily data files. Each root's URL is written on-chain for good, so production stores them in a
# bucket. On Railway it is the project's own bucket (longyu-data): these four settings refer to it
# in .railway/railway.ts and are never typed by hand. Check it with: npm run storage:check
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# A Railway bucket is private, so this API serves the files at /data/roots/ and the address below
# is its own public address plus /data; production refuses anything else. Set STORAGE_PUBLIC_READ=true
# only for a bucket with its own public address (Cloudflare R2 with a custom domain).
STORAGE_PUBLIC_READ=false
PUBLIC_DATA_BASE_URL=https://api-testnet.longyu.network/data
# Development only, when STORAGE_BUCKET is blank: files on local disk, served by the API under /data.
DATA_DIR=/data
RUN_JOBS=true
